---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Juwon Um" sideBarActiveItemID="publications">
  <div>
    <div class="text-3xl w-full font-bold mb-5">2026</div>
  </div>

  <HorizontalCard
    title="When Fingers Become Tools: Rendering Virtual Tool Inertia with a Finger-Mounted Extending Rod"
    img="/whenfingerbecomestool.webp"
    desc="Seongjun Kang, Gwangbin Kim, Bocheon Gim, Jeongju Park, <u>Juwon Um</u>, Semoo Shin, Chanyoung Park, and SeungJun Kim"
    badges={[]}
    url="https://dl.acm.org/doi/full/10.1145/3772318.3791755"
    extra="<i>CHI 2026</i> : Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems"
  />
  <div class="divider my-0 mt-10"></div>


  <div>
    <div class="text-3xl w-full font-bold mb-5">2025</div>
  </div>

  <HorizontalCard
    title="Defying Gravity: Towards Gravitoinertial Retargeting of Acceleration for Virtual Vertical Motion in In-Car VR"
    img="/defyingGravity.webp"
    desc="Bocheon Gim, Seongjun Kang, Dohyeon Yeo, Gwangbin Kim, <u>Juwon Um</u>, Jeongju Park, and SeungJun Kim"
    badges={[]}
    url="https://ieeexplore.ieee.org/document/11220362/"
    extra="<i>ISMAR 2025</i> : 2025 IEEE International Symposium on Mixed and Augmented Reality"
  />
  <HorizontalCard
    title="TeleHopper: Simulating a Jumping Sensation as Proprioceptive Feedback for Teleportation in Virtual Reality via Electrical Muscle Stimulation"
    img="/telehopper_webp.webp"
    desc="<u>Juwon Um</u>, Bocheon Gim, Seongjun Kang, Yumin Kang, Eunki Jeon, and SeungJun Kim"
    badges={["1st Author"]}
    url="https://doi.org/10.1145/3706599.3720248"
    extra="<i>CHI EA 2025</i> : Proceedings of the 2025 CHI Conference on Human Factors in Computing Systems"
  />
  <div class="divider my-0 mt-10"></div>


  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">2024</div>
  </div>

  <HorizontalCard
    title="LegSense: Inducing Walking Sensation in Seated VR by Providing Movement Illusion via Electrical Muscle Stimulation "
    img="/LegSense_webp.webp"
    desc="<u>Juwon Um</u>, Eunki Jeon, Yumin Kang, Seongjun Kang, Ahmed Elsharkawy, Joseph DelPreto, Wojciech Matusik, Daniela Rus, and SeungJun Kim"
    badges={["1st Author"]}
    url="https://doi.org/10.1145/3675094.3678375"
    extra="<i>Ubicomp Companion 2024</i> : Companion of the 2024 on ACM International Joint Conference on Pervasive and Ubiquitous Computing"
  />
  <div class="divider my-0 mt-10"></div>


  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">2022</div>
  </div>

  <HorizontalCard
    title="Haptic Interaction Module for VR Fishing Leisure Activity"
    img="/HapticLeisure.webp"
    desc="Yong Hae Heo, Seongho Kim, <u>Juwon Um</u>, Gyubin An, and Sang-Youn Kim"
    badges={["Best Demo Award"]}
    url="https://doi.org/10.1145/3562939.3565677"
    extra="<i>VRST 2022</i> : Proceedings of the 28th ACM Symposium on Virtual Reality Software and Technology, 2022"
  />
  <div class="divider my-0 mt-10"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">More Publications</div>
  </div>

  <HorizontalCard
    title="TherMusic: A Valence-Arousal-Based Music Emotion Classifier and Thermal Feedback Headset System"
    img="/TherMusic.webp"
    desc="Seongjun Kang, Bocheon Gim, <u>Juwon Um</u>, and SeungJun Kim"
    badges={["Best Paper Award"]}
    url="https://drive.google.com/file/d/1zzFlPxAglVimVZo42ODQrhVgkwaR3MN-/view"
    extra="<i>KIISE Korea Computer Congress 2025</i> : In Proceedings of the Korean Information Science Society Conference. Korean Institute of Information Scientists and Engineers, 2025"
  />
  <HorizontalCard
    title="Utilizing Real-Time Video Matting to create a Scalable System for Real Hand Visualization and Interaction within Augmented Virtuality"
    img="/Utilizing.webp"
    desc="Bocheon Gim, Seongjun Kang, <u>Juwon Um</u>, and SeungJun Kim"
    badges={[]}
    url="https://drive.google.com/file/d/19iPgUeTzQq5FggVdwBp31KxVJdeQvIlV/view"
    extra="<i>KIISE Korea Computer Congress 2025</i> : In Proceedings of the Korean Information Science Society Conference. Korean Institute of Information Scientists and Engineers, 2025"
  />

</BaseLayout>
