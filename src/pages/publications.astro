    url=""
    extra="<i>UIST-Adjunct 2026</i> : The ACM Symposium on User Interface Software and Technology Adjunct"
  />

  <HorizontalCard
    title="Inertia in Your Hand: Rendering Virtual Tool Dynamics via In-Hand Cutaneous Deformation"
